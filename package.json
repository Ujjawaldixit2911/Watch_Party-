{
  "name": "watch-party-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev --workspace=@watchparty/backend\" \"npm run dev --workspace=@watchparty/frontend\"",
    "build": "npm run build --workspace=@watchparty/shared && npm run build --workspace=@watchparty/backend && npm run build --workspace=@watchparty/frontend",
    "test": "npm run test --workspace=@watchparty/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
