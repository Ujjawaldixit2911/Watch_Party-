generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  name           String
  passwordHash   String
  avatar         String?
  bio            String?
  favoriteGenre  String?            @default("Pop & EDM")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdRooms   UserCreatedRoom[]
  joinedRooms    UserJoinedRoom[]

  @@index([email])
}

model UserCreatedRoom {
  id        String   @id @default(uuid())
  userId    String
  code      String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserJoinedRoom {
  id        String   @id @default(uuid())
  userId    String
  code      String
  name      String
  hostName  String?
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id             String        @id @default(uuid())
  code           String        @unique
  name           String?
  hostId         String
  currentVideoId String?
  status         String        @default("ACTIVE") // ACTIVE | CLOSED
  createdAt      DateTime      @default(now())
  closedAt       DateTime?
  participants   Participant[]

  @@index([code])
}

model Participant {
  id               String    @id @default(uuid())
  roomId           String
  username         String
  role             String    @default("PARTICIPANT") // HOST | MODERATOR | PARTICIPANT
  sessionTokenHash String
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?
  removedAt        DateTime?
  room             Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([sessionTokenHash])
  @@unique([roomId, username])
}
